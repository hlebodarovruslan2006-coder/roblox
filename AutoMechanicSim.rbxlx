<Item class="Part" referent="RBXCAR00173"><Properties><string name="Name">Hub</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool><CoordinateFrame name="CFrame"><X>2.62</X><Y>1.05</Y><Z>4.45</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4291086284</Color3uint8><token name="Material">1088</token><float name="Reflectance">0.2</float><float name="Transparency">0</float><Vector3 name="size"><X>1.08</X><Y>0.42</Y><Z>0.42</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item>
<Item class="Part" referent="RBXCAR00174"><Properties><string name="Name">HubCap</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool><CoordinateFrame name="CFrame"><X>2.62</X><Y>1.05</Y><Z>4.45</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282796110</Color3uint8><token name="Material">272</token><float name="Reflectance">0</float><float name="Transparency">0</float><Vector3 name="size"><X>1.1</X><Y>0.18</Y><Z>0.18</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000A"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000008"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- HUD (LocalScript, StarterPlayerScripts)
-- Интерфейс v4 (парковка, банк, часы/погода, музыка, автозакрытие окон). Было: v3 (3D-модели деталей, название мастерской): деньги, уведомления, компьютер (магазин/персонал/донат), склад, панель ремонта.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("MechanicConfig"))
local remotes = ReplicatedStorage:WaitForChild("MechanicRemotes")
local NotifyEvent = remotes:WaitForChild("Notify")
local OpenUIEvent = remotes:WaitForChild("OpenUI")
local JobUpdateEvent = remotes:WaitForChild("JobUpdate")
local JobActionEvent = remotes:WaitForChild("JobAction")
local ShopFunction = remotes:WaitForChild("ShopAction")
local ParkingEvent = remotes:WaitForChild("Parking")
local SoundService = game:GetService("SoundService")
local PartModels = require(ReplicatedStorage:WaitForChild("PartModels"))

local COLORS = {
	bg = Color3.fromRGB(28, 30, 38),
	panel = Color3.fromRGB(40, 43, 54),
	card = Color3.fromRGB(52, 56, 70),
	text = Color3.fromRGB(235, 235, 240),
	dim = Color3.fromRGB(160, 165, 180),
	good = Color3.fromRGB(60, 170, 90),
	bad = Color3.fromRGB(200, 60, 60),
	info = Color3.fromRGB(60, 110, 200),
	warn = Color3.fromRGB(230, 160, 30),
	btn = Color3.fromRGB(70, 110, 210),
	gray = Color3.fromRGB(90, 92, 104),
}

local function new(cls, props, children)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(o, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = o })
	return o
end

local function pad(o, n)
	new("UIPadding", { PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n), PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n), Parent = o })
	return o
end

local function label(parent, text, size, color, h, bold)
	return new("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, h or 20),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextSize = size or 14,
		TextColor3 = color or COLORS.text,
	})
end

local function button(parent, text, color, w, h, cb)
	local b = new("TextButton", {
		Parent = parent,
		Size = UDim2.new(0, w or 120, 0, h or 30),
		BackgroundColor3 = color or COLORS.btn,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextWrapped = true,
		AutoButtonColor = true,
	})
	corner(b, 6)
	if cb then
		b.MouseButton1Click:Connect(cb)
	end
	return b
end

local function row(parent, h)
	local f = new("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 32) })
	new("UIListLayout", { Parent = f, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center })
	return f
end

local function clear(f)
	for _, c in ipairs(f:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

local function window(name, title, size, pos)
	local w = new("Frame", { Name = name, BackgroundColor3 = COLORS.bg, Size = size, Position = pos, Visible = false })
	corner(w, 10)
	local head = new("TextLabel", { Parent = w, BackgroundTransparency = 1, Size = UDim2.new(1, -50, 0, 36), Position = UDim2.new(0, 14, 0, 4), Text = title, Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = COLORS.text, TextXAlignment = Enum.TextXAlignment.Left })
	local close = button(w, "✕", COLORS.bad, 30, 30)
	close.Position = UDim2.new(1, -38, 0, 6)
	local body = new("ScrollingFrame", { Parent = w, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 1, -52), Position = UDim2.new(0, 8, 0, 44), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, BorderSizePixel = 0 })
	new("UIListLayout", { Parent = body, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	return w, body, close, head
end

local function card(parent, color)
	local c = new("Frame", { Parent = parent, BackgroundColor3 = color or COLORS.card, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	corner(c, 8)
	pad(c, 8)
	new("UIListLayout", { Parent = c, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	return c
end

local function iconLine(parent, id, text, px, rotate, textSize)
	local r = row(parent, px)
	pcall(PartModels.viewport, id, r, UDim2.new(0, px, 0, px), rotate)
	local l = label(r, text, textSize or 13, COLORS.text, px)
	l.Size = UDim2.new(1, -(px + 8), 0, px)
	l.AutomaticSize = Enum.AutomaticSize.None
	l.TextYAlignment = Enum.TextYAlignment.Center
	return r
end

---------------------------------------------------------------- ОСНОВА
local gui = new("ScreenGui", { Name = "MechanicUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

local top = new("Frame", { Parent = gui, BackgroundColor3 = COLORS.bg, Size = UDim2.new(0, 300, 0, 44), Position = UDim2.new(0, 12, 1, -56) })
local shopLbl = new("TextLabel", { Parent = gui, BackgroundTransparency = 1, Size = UDim2.new(0, 400, 0, 24), Position = UDim2.new(0, 14, 1, -84), Font = Enum.Font.GothamBlack, TextSize = 18, TextColor3 = Color3.fromRGB(255, 200, 90), TextStrokeTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Left, Text = "" })
corner(top, 10)
local cashLbl = new("TextLabel", { Parent = top, BackgroundTransparency = 1, Size = UDim2.new(0, 160, 1, 0), Position = UDim2.new(0, 12, 0, 0), Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = Color3.fromRGB(120, 230, 120), TextXAlignment = Enum.TextXAlignment.Left, Text = "💰 $0" })
local invBtn = button(top, "📦 Склад", COLORS.btn, 110, 32)
invBtn.Position = UDim2.new(1, -118, 0, 6)

local notifHolder = new("Frame", { Parent = gui, BackgroundTransparency = 1, Size = UDim2.new(0, 520, 0, 300), Position = UDim2.new(0.5, -260, 0, 10), ZIndex = 10 })
new("UIListLayout", { Parent = notifHolder, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center })
local notifCount = 0
NotifyEvent.OnClientEvent:Connect(function(text, kind)
	notifCount = notifCount + 1
	local f = new("TextLabel", {
		Parent = notifHolder, LayoutOrder = notifCount, ZIndex = 10,
		Size = UDim2.new(1, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS[kind] or COLORS.info, BackgroundTransparency = 0.1,
		Text = text, TextWrapped = true, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = Color3.new(1, 1, 1),
	})
	corner(f, 8)
	pad(f, 8)
	local kids = {}
	for _, c in ipairs(notifHolder:GetChildren()) do
		if c:IsA("TextLabel") then
			table.insert(kids, c)
		end
	end
	if #kids > 5 then
		kids[1]:Destroy()
	end
	task.delay(6, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end)

local function cash()
	local ls = player:FindFirstChild("leaderstats")
	local c = ls and ls:FindFirstChild("Деньги")
	return c and c.Value or 0
end

local function inv(id)
	return player:GetAttribute("Inv_" .. id) or 0
end

local function owns(id)
	return player:GetAttribute("Own_" .. id) == true
end

local function toast(text, kind)
	-- локальное уведомление (тот же вид)
	local f = new("TextLabel", {
		Parent = notifHolder, LayoutOrder = notifCount + 1, ZIndex = 10,
		Size = UDim2.new(1, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS[kind] or COLORS.info, BackgroundTransparency = 0.1,
		Text = text, TextWrapped = true, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = Color3.new(1, 1, 1),
	})
	notifCount = notifCount + 1
	corner(f, 8)
	pad(f, 8)
	task.delay(5, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

local function shop(action, id, qty)
	local ok, msg = ShopFunction:InvokeServer(action, id, qty)
	if msg then
		if ok then
			toast(msg, "good")
		else
			toast(msg, "bad")
		end
	end
end

---------------------------------------------------------------- КОМПЬЮТЕР
local compWin, compBody, compClose, compHead = window("Computer", "🖥 Компьютер автосервиса", UDim2.new(0, 640, 0, 520), UDim2.new(0.5, -320, 0.5, -260))
compWin.Parent = gui
local function refreshShopName()
	local n = player:GetAttribute("ShopName") or Config.DefaultShopName
	compHead.Text = "🖥 Компьютер «" .. n .. "»"
	shopLbl.Text = "🏪 " .. n
end
player:GetAttributeChangedSignal("ShopName"):Connect(refreshShopName)
refreshShopName()
compBody.Size = UDim2.new(1, -16, 1, -96)
compBody.Position = UDim2.new(0, 8, 0, 88)
local tabsRow = row(compWin, 36)
tabsRow.Position = UDim2.new(0, 10, 0, 44)
tabsRow.Size = UDim2.new(1, -20, 0, 36)

local TABS = {
	{ id = "part", name = "Запчасти" },
	{ id = "fluid", name = "Тех. жидкости" },
	{ id = "tool", name = "Инструменты" },
	{ id = "equip", name = "Оборудование" },
	{ id = "staff", name = "Персонал" },
	{ id = "trans", name = "⚙ КПП" },
	{ id = "donate", name = "⭐ Донат" },
}
local currentTab = "part"
local tabButtons = {}
local renderComputer

for i, t in ipairs(TABS) do
	local b = button(tabsRow, t.name, COLORS.gray, 82, 32, function()
		currentTab = t.id
		renderComputer()
	end)
	b.LayoutOrder = i
	tabButtons[t.id] = b
end

local function itemRow(it)
	local c = card(compBody)
	local head = row(c, 84)
	pcall(PartModels.viewport, it.id, head, UDim2.new(0, 84, 0, 84), true)
	local info = new("Frame", { Parent = head, BackgroundTransparency = 1, Size = UDim2.new(1, -96, 0, 84) })
	new("UIListLayout", { Parent = info, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	label(info, it.name .. "  —  $" .. it.price, 15, COLORS.text, 18, true)
	label(info, "Для чего: " .. it.desc, 13, COLORS.dim, 16)
	local r = row(c, 32)
	if it.cat == "part" or it.cat == "fluid" then
		local st = label(r, "На складе: " .. inv(it.id), 13, COLORS.text, 30)
		st.Size = UDim2.new(0, 150, 0, 30)
		st.AutomaticSize = Enum.AutomaticSize.None
		st.TextYAlignment = Enum.TextYAlignment.Center
		button(r, "Заказать x1", COLORS.btn, 120, 30, function()
			shop("buy", it.id, 1)
		end)
		button(r, "x5 ($" .. it.price * 5 .. ")", COLORS.btn, 120, 30, function()
			shop("buy", it.id, 5)
		end)
	else
		if it.vip then
			if owns(it.id) then
				button(r, "✔ Есть (VIP)", COLORS.good, 140, 30)
			else
				button(r, "⭐ Только с VIP-пассом", COLORS.warn, 200, 30, function()
					currentTab = "donate"
					renderComputer()
				end)
			end
		elseif owns(it.id) then
			button(r, "✔ Куплено", COLORS.good, 140, 30)
		else
			button(r, "Купить за $" .. it.price, COLORS.btn, 160, 30, function()
				shop("buy", it.id, 1)
			end)
		end
	end
end

renderComputer = function()
	if not compWin.Visible then
		return
	end
	for id, b in pairs(tabButtons) do
		if id == currentTab then
			b.BackgroundColor3 = COLORS.btn
		else
			b.BackgroundColor3 = COLORS.gray
		end
	end
	local y = compBody.CanvasPosition
	clear(compBody)
	if currentTab == "part" or currentTab == "fluid" or currentTab == "trans" then
		local note = "🚚 Доставка заказа: " .. Config.DeliveryTime .. " сек. Администратор заказывает мгновенно и на 10% дешевле."
		if player:GetAttribute("Hire_admin") then
			note = "🧑‍💼 Администратор на месте: доставка мгновенная, скидка 10%."
		end
		label(compBody, note, 13, COLORS.warn, 18, true)
	end
	if currentTab == "staff" then
		label(compBody, "Работники берут детали со склада и чинят сами. Зарплаты нет — платите только за найм.", 13, COLORS.warn, 18, true)
		for _, w in ipairs(Config.Workers) do
			local c = card(compBody)
			label(c, w.name .. "  —  найм $" .. w.hire .. ", без зарплаты", 15, COLORS.text, 18, true)
			label(c, w.desc, 13, COLORS.dim, 16)
			local r = row(c, 32)
			if player:GetAttribute("Hire_" .. w.id) then
				button(r, "Уволить", COLORS.bad, 120, 30, function()
					shop("fire", w.id)
				end)
			else
				button(r, "Нанять за $" .. w.hire, COLORS.good, 160, 30, function()
					shop("hire", w.id)
				end)
			end
		end
	elseif currentTab == "donate" then
		for _, key in ipairs(Config.DonateOrder or { "x2cash", "x2speed" }) do
			local gp = Config.GamePasses[key]
			if gp then
				local c = card(compBody, Color3.fromRGB(70, 55, 20))
				label(c, "⭐ " .. gp.name, 16, Color3.fromRGB(255, 215, 90), 20, true)
				label(c, gp.desc, 13, COLORS.text, 16)
				local r = row(c, 32)
				if player:GetAttribute("Pass_" .. key) then
					button(r, "✔ Активно", COLORS.good, 140, 30)
				elseif (gp.id or 0) <= 0 and not RunService:IsStudio() then
					button(r, "Скоро", Color3.fromRGB(90, 90, 90), 140, 30)
				else
					button(r, "Купить", COLORS.warn, 140, 30, function()
						shop("pass", key)
					end)
				end
			end
		end
		for key, dp in pairs(Config.DevProducts or {}) do
			local c = card(compBody, Color3.fromRGB(40, 60, 90))
			label(c, "⚡ " .. dp.name, 16, Color3.fromRGB(140, 210, 255), 20, true)
			label(c, dp.desc, 13, COLORS.text, 16)
			local left = (player:GetAttribute("BoostUntil") or 0) - workspace:GetServerTimeNow()
			if key == "boost30" and left > 0 then
				label(c, "Сейчас активен, осталось ~" .. math.ceil(left / 60) .. " мин.", 13, COLORS.good, 16, true)
			end
			local r = row(c, 32)
			if (dp.id or 0) <= 0 and not RunService:IsStudio() then
				button(r, "Скоро", Color3.fromRGB(90, 90, 90), 140, 30)
			else
				button(r, "Купить", COLORS.warn, 140, 30, function()
					shop("product", key)
				end)
			end
		end
	else
		for _, it in ipairs(Config.Items) do
			local match = (currentTab == "trans") and (it.group == "trans") or (it.cat == currentTab and it.group ~= "trans")
			if match then
				itemRow(it)
			end
		end
	end
	compBody.CanvasPosition = y
end

compClose.MouseButton1Click:Connect(function()
	compWin.Visible = false
end)

---------------------------------------------------------------- СКЛАД
local invWin, invBody, invClose = window("Inventory", "📦 Склад и инструменты", UDim2.new(0, 380, 0, 460), UDim2.new(0, 12, 0.5, -260))
invWin.Parent = gui

local function renderInventory()
	if not invWin.Visible then
		return
	end
	clear(invBody)
	label(invBody, "Запчасти и жидкости:", 15, COLORS.warn, 18, true)
	local any = false
	for _, it in ipairs(Config.Items) do
		if (it.cat == "part" or it.cat == "fluid") and inv(it.id) > 0 then
			iconLine(invBody, it.id, it.name .. ": " .. inv(it.id) .. " шт.", 44, false, 14)
			any = true
		end
	end
	if not any then
		label(invBody, "пусто — закажите в компьютере", 14, COLORS.dim)
	end
	label(invBody, "Инструменты и оборудование:", 15, COLORS.warn, 18, true)
	any = false
	for _, it in ipairs(Config.Items) do
		if (it.cat == "tool" or it.cat == "equip") and owns(it.id) then
			iconLine(invBody, it.id, "✔ " .. it.name, 44, false, 14)
			any = true
		end
	end
	if not any then
		label(invBody, "пока только обычный ключ", 14, COLORS.dim)
	end
end

invBtn.MouseButton1Click:Connect(function()
	invWin.Visible = not invWin.Visible
	renderInventory()
end)
invClose.MouseButton1Click:Connect(function()
	invWin.Visible = false
end)

---------------------------------------------------------------- ПАНЕЛЬ РЕМОНТА
local jobWin, jobBody, jobClose, jobHead = window("Job", "🔧 Ремонт", UDim2.new(0, 440, 0, 560), UDim2.new(1, -452, 0.5, -280))
jobWin.Parent = gui
local snap = nil
local renderJob
local boltMode = "unscrew"
local bars = {}

local function act(action, faultIdx, arg)
	if snap then
		JobActionEvent:FireServer(action, snap.bay, faultIdx, arg)
	end
end

local function progressBar(parent, remaining, total, text)
	local holder = new("Frame", { Parent = parent, BackgroundColor3 = COLORS.bg, Size = UDim2.new(1, 0, 0, 24) })
	corner(holder, 6)
	local fill = new("Frame", { Parent = holder, BackgroundColor3 = COLORS.warn, Size = UDim2.new(0, 0, 1, 0) })
	corner(fill, 6)
	new("TextLabel", { Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = text or "", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), ZIndex = 2 })
	table.insert(bars, { fill = fill, endAt = os.clock() + remaining, total = math.max(total or 1, 0.1) })
end

RunService.Heartbeat:Connect(function()
	for _, b in ipairs(bars) do
		if b.fill.Parent then
			local left = math.max(0, b.endAt - os.clock())
			b.fill.Size = UDim2.new(1 - left / b.total, 0, 1, 0)
		end
	end
end)

local BOLT_ICON = { ok = "🔩", rusty = "🟤", soaked = "💧", broken = "💥", done = "✔" }
local BOLT_COLOR = { ok = COLORS.gray, rusty = Color3.fromRGB(150, 80, 30), soaked = COLORS.info, broken = COLORS.bad, done = COLORS.good }

local function renderStep(c, f)
	local st = f.step
	label(c, "Шаг " .. f.stepIdx .. "/" .. f.stepCount .. ": " .. st.label, 14, COLORS.warn, 18, true)
	label(c, "📍 Где: " .. st.atName, 13, COLORS.dim, 16)
	for _, t in ipairs(st.tools) do
		local mark = "❌ "
		if owns(t.id) then
			mark = "✅ "
		end
		iconLine(c, t.id, mark .. t.name, 36, false)
	end
	for _, it in ipairs(st.items) do
		local have = inv(it.id)
		local mark = "❌ "
		if have >= it.need then
			mark = "✅ "
		end
		iconLine(c, it.id, mark .. it.name .. " (" .. have .. "/" .. it.need .. ")", 36, false)
	end

	if f.busyRemaining and f.busyRemaining > 0 then
		progressBar(c, f.busyRemaining - (os.clock() - snap._recv), f.busyTotal, f.busyLabel)
		return
	end

	if st.type == "bolts" and f.bolts then
		label(c, "Режим (выберите, потом нажмите на болт):", 13, COLORS.dim, 16)
		local modes = row(c, 32)
		local keyName = "🔧 Ключ"
		if owns("impact") then
			keyName = "⚡ Гайковёрт"
		end
		local defs = {
			{ id = "unscrew", name = keyName },
			{ id = "wd40", name = "🧴 WD-40 (" .. inv("wd40") .. ")" },
			{ id = "hammer", name = "🔨 Молоток" },
		}
		if owns("vip_impact") then
			table.insert(defs, 1, { id = "vip", name = "⭐ VIP: все разом" })
		end
		for i, m in ipairs(defs) do
			local col = COLORS.gray
			if boltMode == m.id then
				col = COLORS.btn
			end
			local b = button(modes, m.name, col, (#defs > 3) and 93 or 128, 30, function()
				boltMode = m.id
				renderJob()
			end)
			b.LayoutOrder = i
		end
		local grid = new("Frame", { Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		new("UIGridLayout", { Parent = grid, CellSize = UDim2.new(0, 46, 0, 46), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		for k, state in ipairs(f.bolts) do
			local b = button(grid, BOLT_ICON[state] or "?", BOLT_COLOR[state] or COLORS.gray, 46, 46, function()
				act("bolt", f.idx, { bolt = k, method = boltMode })
			end)
			b.TextSize = 22
			b.LayoutOrder = k
		end
		label(c, "🔩 обычный  🟤 ржавый (может сорваться, 15%)  💧 обработан  💥 сорван — нужен экстрактор", 12, COLORS.dim, 16)
	elseif st.type == "action" then
		if st.wait then
			label(c, "⏳ Этот шаг идёт сам (" .. math.floor((st.time or 0) / 60) .. " мин " .. math.floor((st.time or 0) % 60) .. " сек). Запустите и занимайтесь другой машиной — придёт уведомление.", 12, COLORS.dim, 16)
		end
		local r = row(c, 34)
		button(r, (st.wait and "⏳ " or "▶ ") .. st.label, COLORS.good, 300, 32, function()
			act("do", f.idx)
		end)
	elseif st.type == "torque" then
		local r = row(c, 34)
		button(r, "🔧 Динамометрический ключ", COLORS.good, 220, 32, function()
			act("do", f.idx, "wrench")
		end)
		button(r, "👀 На глаз (риск)", COLORS.bad, 170, 32, function()
			act("do", f.idx, "eye")
		end)
	elseif st.type == "grease" then
		label(c, "Медная смазка защищает от закисания: +15% к оплате", 13, COLORS.dim, 16)
		local r = row(c, 34)
		button(r, "🟠 Нанести (" .. inv("copper_grease") .. ")", COLORS.good, 200, 32, function()
			act("do", f.idx, "apply")
		end)
		button(r, "Пропустить", COLORS.gray, 140, 32, function()
			act("do", f.idx, "skip")
		end)
	end
end

renderJob = function()
	bars = {}
	if not jobWin.Visible or not snap then
		return
	end
	local y = jobBody.CanvasPosition
	clear(jobBody)
	if not snap.hasJob then
		jobHead.Text = "🔧 Пост " .. (snap.bayLocal or snap.bay)
		label(jobBody, "Машины нет — ждём следующего клиента...", 15, COLORS.dim)
		return
	end
	jobHead.Text = "🔧 " .. snap.car .. " (пост " .. (snap.bayLocal or snap.bay) .. ")"

	if snap.missing and #snap.missing > 0 then
		local c = card(jobBody, Color3.fromRGB(60, 50, 90))
		local names = {}
		for _, m in ipairs(snap.missing) do
			table.insert(names, m.name .. " x" .. m.n)
		end
		label(c, "📦 Не хватает на складе: " .. table.concat(names, ", "), 13, COLORS.text)
		if snap.hasAdmin then
			local r = row(c, 34)
			button(r, "🧑‍💼 Купить нужные запчасти ($" .. (snap.missingCost or 0) .. ")", COLORS.good, 380, 32, function()
				shop("buyNeeded", tostring(snap.bay))
			end)
		else
			label(c, "Наймите администратора — он докупит всё одной кнопкой прямо у машины и выдаст мгновенно.", 12, COLORS.dim)
		end
	end

	if snap.hasHidden then
		local c = card(jobBody, Color3.fromRGB(90, 60, 15))
		label(c, "⚠ CHECK ENGINE — неизвестная ошибка!", 15, Color3.fromRGB(255, 200, 60), 18, true)
		label(c, "Подключите автосканер OBD-II, чтобы узнать, что чинить.", 13, COLORS.text, 16)
		if snap.scanRemaining > 0 then
			progressBar(c, snap.scanRemaining - (os.clock() - snap._recv), snap.scanTotal, "Читаем ошибки...")
		else
			local r = row(c, 34)
			local txt = "🔍 Сканировать"
			if not owns("scanner") then
				txt = "🔍 Сканировать (нет сканера ❌)"
			end
			button(r, txt, COLORS.warn, 300, 32, function()
				act("scan")
			end)
		end
	end

	for _, f in ipairs(snap.faults) do
		if f.revealed then
			local col = COLORS.card
			if f.done then
				col = Color3.fromRGB(35, 70, 45)
			end
			local c = card(jobBody, col)
			local title = f.name
			if f.code then
				title = "[" .. f.code .. "] " .. title
			end
			if f.done then
				title = "✅ " .. title
			end
			label(c, title, 15, COLORS.text, 18, true)
			if not f.done then
				local info = "Оплата: $" .. (f.reward or 0)
				if f.variantName then
					info = info .. "  •  " .. f.variantName
				end
				if f.liftText then
					info = info .. "  •  " .. f.liftText
				end
				label(c, info, 13, COLORS.dim, 16)
				if f.lockedName and not f.mine then
					label(c, "🔒 Занимается: " .. f.lockedName, 13, COLORS.warn, 16)
					if f.busyRemaining and f.busyRemaining > 0 then
						progressBar(c, f.busyRemaining - (os.clock() - snap._recv), f.busyTotal, f.busyLabel)
					end
				elseif f.mine and f.step then
					renderStep(c, f)
					local r = row(c, 30)
					button(r, "Бросить ремонт", COLORS.gray, 140, 26, function()
						act("abandon", f.idx)
					end)
				elseif f.variants then
					label(c, "Выберите способ ремонта:", 13, COLORS.text, 16)
					for _, v in ipairs(f.variants) do
						local r = row(c, 34)
						button(r, v.name .. " — $" .. v.reward, COLORS.good, 380, 32, function()
							act("start", f.idx, v.id)
						end)
					end
				else
					local r = row(c, 34)
					local txt = "▶ Начать ремонт"
					if f.mine then
						txt = "▶ Продолжить"
					end
					button(r, txt, COLORS.good, 200, 32, function()
						act("start", f.idx)
					end)
				end
			end
		end
	end

	local r = row(jobBody, 34)
	button(r, "🚫 Отказать клиенту", COLORS.bad, 200, 30, function()
		act("refuse")
	end)
	jobBody.CanvasPosition = y
end

JobUpdateEvent.OnClientEvent:Connect(function(s)
	s._recv = os.clock()
	snap = s
	renderJob()
end)

jobClose.MouseButton1Click:Connect(function()
	jobWin.Visible = false
end)
jobWin:GetPropertyChangedSignal("Visible"):Connect(function()
	if not jobWin.Visible then
		JobActionEvent:FireServer("close")
	end
end)

---------------------------------------------------------------- ПАРКОВКА
local parkWin, parkBody, parkClose, parkHead = window("Parking", "🅿 Машина клиента", UDim2.new(0, 420, 0, 430), UDim2.new(0.5, -210, 0.5, -215))
parkWin.Parent = gui
parkClose.MouseButton1Click:Connect(function()
	parkWin.Visible = false
end)
local function renderParking(data)
	clear(parkBody)
	parkHead.Text = "🅿 " .. tostring(data.car or "Машина") .. " (P" .. tostring(data.spot) .. ")"
	local c = card(parkBody, COLORS.card)
	label(c, "Неисправности:", 15, COLORS.text, 18, true)
	for _, n in ipairs(data.faults or {}) do
		label(c, "• " .. n, 13, COLORS.dim, 16)
	end
	if data.tutorial then
		label(parkBody, "👴 Михалыч: «Гони на пост " .. tostring(data.pitBay) .. " — там смотровая яма, масло меняют снизу»", 13, COLORS.warn)
	end
	label(parkBody, "Сесть за руль и отогнать на пост:", 15, COLORS.text, 18, true)
	for _, b in ipairs(data.bays or {}) do
		local r = row(parkBody, 36)
		if b.locked then
			button(r, "🔒 Пост " .. b.idx .. " · ⭐ донат «+1 подъёмник»", Color3.fromRGB(110, 85, 30), 340, 32, function()
				toast("Пост " .. b.idx .. " открывается в Компьютер → ⭐ Донат", "info")
			end)
		else
			local txt = "🚗 Пост " .. b.idx .. (b.pit and " · смотровая яма" or "") .. (b.bonus and " · ⭐ подъёмник" or "") .. (b.free and "" or " — занят")
			button(r, txt, b.free and COLORS.good or COLORS.gray, 340, 32, function()
				if not b.free then
					toast("Этот пост занят", "bad")
					return
				end
				parkWin.Visible = false
				ParkingEvent:FireServer("drive", data.spot, b.idx)
			end)
		end
	end
end

---------------------------------------------------------------- БАНК
local bankWin, bankBody, bankClose = window("Bank", "🏦 Банк · кредит без процентов", UDim2.new(0, 420, 0, 440), UDim2.new(0.5, -210, 0.5, -220))
bankWin.Parent = gui
bankClose.MouseButton1Click:Connect(function()
	bankWin.Visible = false
end)
local function renderBank()
	if not bankWin.Visible then
		return
	end
	clear(bankBody)
	local debt = player:GetAttribute("Loan") or 0
	label(bankBody, "Ваш долг: $" .. debt .. "   (лимит $" .. (Config.LoanMax or 1500) .. ")", 16, debt > 0 and COLORS.warn or COLORS.good, 22, true)
	label(bankBody, "Процентов нет. Возвращаете сами, когда удобно.", 13, COLORS.dim)
	for _, a in ipairs(Config.Loans or {}) do
		local r = row(bankBody, 36)
		local can = debt + a <= (Config.LoanMax or 1500)
		button(r, "💵 Взять $" .. a, can and COLORS.btn or COLORS.gray, 220, 32, function()
			shop("loan", tostring(a))
		end)
	end
	if debt > 0 then
		local r = row(bankBody, 36)
		button(r, "✅ Погасить весь долг ($" .. debt .. ")", COLORS.good, 300, 32, function()
			shop("repay", tostring(debt))
		end)
		local r2 = row(bankBody, 36)
		button(r2, "Погасить $100", COLORS.good, 220, 32, function()
			shop("repay", "100")
		end)
	end
end

---------------------------------------------------------------- МАСТЕРСКАЯ: НАГРАДА, ЗАДАНИЯ, РАНГ, РЕЙТИНГ, ЛИДЕРЫ
local HttpService = game:GetService("HttpService")
local progWin, progBody, progClose = window("Progress", "📋 Мастерская", UDim2.new(0, 460, 0, 520), UDim2.new(0.5, -230, 0.5, -260))
progWin.Parent = gui
progClose.MouseButton1Click:Connect(function()
	progWin.Visible = false
end)
local progBtn = button(gui, "📋 Мастерская", COLORS.btn, 150, 36)
progBtn.Position = UDim2.new(0, 322, 1, -52)
local statusLbl = new("TextLabel", { Parent = gui, BackgroundTransparency = 1, Size = UDim2.new(0, 520, 0, 20), Position = UDim2.new(0, 14, 1, -106), Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = COLORS.text, TextStrokeTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Left, Text = "" })

local function rankInfo()
	local idx = player:GetAttribute("Rank") or 1
	return idx, Config.Ranks[idx] or Config.Ranks[1], Config.Ranks[idx + 1]
end

local function starsText(r)
	if not r or r <= 0 then
		return "нет отзывов"
	end
	local full = math.floor(r + 0.5)
	return string.rep("★", full) .. string.rep("☆", 5 - full) .. string.format(" %.1f", r)
end

local function questList()
	local ok, list = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Quests") or "[]")
	end)
	return ok and list or {}
end

local function hasClaimable()
	if player:GetAttribute("DailyReady") then
		return true
	end
	for _, q in ipairs(questList()) do
		local def = Config.QuestById[q.id]
		if def and not q.claimed and q.n >= def.goal then
			return true
		end
	end
	return false
end

local function bar(parent, frac, color)
	local bg = new("Frame", { Parent = parent, BackgroundColor3 = COLORS.panel, Size = UDim2.new(1, 0, 0, 10) })
	corner(bg, 5)
	local fg = new("Frame", { Parent = bg, BackgroundColor3 = color or COLORS.good, Size = UDim2.new(math.clamp(frac, 0, 1), 0, 1, 0) })
	corner(fg, 5)
	return bg
end

local function renderProgress()
	progBtn.Text = hasClaimable() and "📋 Мастерская ❗" or "📋 Мастерская"
	progBtn.BackgroundColor3 = hasClaimable() and COLORS.warn or COLORS.btn
	if not progWin.Visible then
		return
	end
	local y = progBody.CanvasPosition
	clear(progBody)

	-- ежедневная награда
	local c = card(progBody, Color3.fromRGB(70, 55, 20))
	label(c, "🎁 Ежедневная награда", 16, Color3.fromRGB(255, 215, 90), 20, true)
	local streak = player:GetAttribute("DailyStreak") or 1
	local cells = row(c, 34)
	for i, amount in ipairs(Config.DailyRewards) do
		local active = i == streak
		local got = i < streak or (i == streak and not player:GetAttribute("DailyReady"))
		local cell = new("TextLabel", { Parent = cells, Size = UDim2.new(0, 52, 0, 32), BackgroundColor3 = got and COLORS.good or (active and COLORS.warn or COLORS.gray), Text = "Д" .. i .. "\n$" .. amount, TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), LayoutOrder = i })
		corner(cell, 6)
	end
	local vip = player:GetAttribute("Pass_vip") == true
	label(c, "Заходите каждый день подряд — награда растёт." .. (vip and " ⭐ VIP: награда x" .. (Config.VipDailyMultiplier or 2) or ""), 12, COLORS.dim, 16)
	local r = row(c, 34)
	if player:GetAttribute("DailyReady") then
		button(r, "Забрать (день " .. streak .. ")", COLORS.good, 200, 32, function()
			shop("daily", "daily")
		end)
	else
		button(r, "✔ Получено — приходите завтра", COLORS.gray, 260, 32)
	end

	-- задания на день
	local qc = card(progBody)
	label(qc, "📋 Задания на день", 16, COLORS.text, 20, true)
	local list = questList()
	if #list == 0 then
		label(qc, "Задания появятся после обучения.", 13, COLORS.dim, 16)
	end
	for _, q in ipairs(list) do
		local def = Config.QuestById[q.id]
		if def then
			local done = q.n >= def.goal
			label(qc, (q.claimed and "✅ " or (done and "🎉 " or "• ")) .. def.text .. "  —  $" .. def.reward, 14, q.claimed and COLORS.dim or COLORS.text, 18, true)
			bar(qc, q.n / def.goal, done and COLORS.good or COLORS.info)
			local qr = row(qc, 30)
			local prog = label(qr, q.n .. " / " .. def.goal, 12, COLORS.dim, 28)
			prog.Size = UDim2.new(0, 160, 0, 28)
			prog.AutomaticSize = Enum.AutomaticSize.None
			prog.TextYAlignment = Enum.TextYAlignment.Center
			if done and not q.claimed then
				button(qr, "Забрать $" .. def.reward, COLORS.good, 150, 28, function()
					shop("quest", q.id)
				end)
			end
		end
	end
	label(qc, "Новые задания — каждые сутки.", 12, COLORS.dim, 16)

	-- ранг и рейтинг
	local idx, rk, nextRk = rankInfo()
	local rc = card(progBody)
	label(rc, "🏅 Ранг мастерской: " .. rk.name .. " (" .. idx .. "/" .. #Config.Ranks .. ")", 16, COLORS.text, 20, true)
	label(rc, "Бонус к доходу: +" .. math.floor(rk.bonus * 100 + 0.5) .. "%", 13, COLORS.good, 16)
	local reps = 0
	local ls = player:FindFirstChild("leaderstats")
	local rv = ls and ls:FindFirstChild("Ремонты")
	if rv then
		reps = rv.Value
	end
	if nextRk then
		bar(rc, (reps - rk.repairs) / (nextRk.repairs - rk.repairs), COLORS.warn)
		label(rc, "До ранга «" .. nextRk.name .. "»: " .. reps .. " / " .. nextRk.repairs .. " ремонтов (+" .. math.floor(nextRk.bonus * 100 + 0.5) .. "%)", 12, COLORS.dim, 16)
	else
		label(rc, "Максимальный ранг!", 12, COLORS.warn, 16)
	end
	local rating = player:GetAttribute("Rating") or 0
	label(rc, "⭐ Рейтинг: " .. starsText(rating) .. "  (" .. (player:GetAttribute("RatingCount") or 0) .. " отзывов)", 15, Color3.fromRGB(255, 215, 90), 20, true)
	label(rc, "Клиент снимает звёзды, если долго ждал (>" .. math.floor((Config.StarSlowTime or 240) / 60) .. " мин), за сорванный болт и за капиталку без динамометрического ключа. Высокий рейтинг = клиенты чаще, а при 4.5★+ чаевые +" .. math.floor((Config.StarTipBonus or 0.2) * 100) .. "%.", 12, COLORS.dim, 16)

	-- таблица лидеров
	local lc = card(progBody)
	label(lc, "🏆 Таблица лидеров (ремонты)", 16, COLORS.text, 20, true)
	local okL, rows = pcall(function()
		return HttpService:JSONDecode(workspace:GetAttribute("Leaderboard") or "[]")
	end)
	if not okL or #rows == 0 then
		label(lc, "Загрузка...", 13, COLORS.dim, 16)
	else
		for i, e in ipairs(rows) do
			if i > (Config.LeaderboardSize or 10) then
				break
			end
			local me = e.name == player.DisplayName
			label(lc, (i <= 3 and ({ "🥇", "🥈", "🥉" })[i] or (i .. ".")) .. " " .. tostring(e.name) .. " — " .. tostring(e.value), 14, me and COLORS.warn or COLORS.text, 18, me)
		end
	end
	progBody.CanvasPosition = y
end

progBtn.MouseButton1Click:Connect(function()
	progWin.Visible = not progWin.Visible
	renderProgress()
end)
workspace:GetAttributeChangedSignal("Leaderboard"):Connect(renderProgress)
task.delay(3, renderProgress)

-- строка статуса: ранг, звёзды, VIP, буст
task.spawn(function()
	while true do
		local _, rk = rankInfo()
		local parts = { "🏅 " .. rk.name, "⭐ " .. starsText(player:GetAttribute("Rating")) }
		if player:GetAttribute("Pass_vip") then
			table.insert(parts, "👑 VIP")
		end
		local left = (player:GetAttribute("BoostUntil") or 0) - workspace:GetServerTimeNow()
		if left > 0 then
			table.insert(parts, string.format("⚡ x2 %d:%02d", math.floor(left / 60), math.floor(left % 60)))
		end
		statusLbl.Text = table.concat(parts, "  ·  ")
		task.wait(1)
	end
end)

local openedAt = {}
local function rootPos()
	local ch = player.Character
	local r = ch and ch:FindFirstChild("HumanoidRootPart")
	return r and r.Position or nil
end

OpenUIEvent.OnClientEvent:Connect(function(name, data)
	if name == "computer" then
		compWin.Visible = true
		renderComputer()
	elseif name == "job" then
		jobWin.Visible = true
		renderJob()
	elseif name == "bank" then
		openedAt.bank = rootPos()
		bankWin.Visible = true
		renderBank()
	elseif name == "parking" and type(data) == "table" then
		openedAt.park = rootPos()
		parkWin.Visible = true
		renderParking(data)
	end
end)

-- отошли от машины / компьютера / банка — окно закрывается само
task.spawn(function()
	while true do
		task.wait(0.3)
		local pos = rootPos()
		if pos then
			if jobWin.Visible and snap and typeof(snap.near) == "Vector3" and (pos - snap.near).Magnitude > 40 then
				jobWin.Visible = false
			end
			local cp = player:GetAttribute("ComputerPos")
			if compWin.Visible and typeof(cp) == "Vector3" and (pos - cp).Magnitude > 20 then
				compWin.Visible = false
			end
			if bankWin.Visible and openedAt.bank and (pos - openedAt.bank).Magnitude > 20 then
				bankWin.Visible = false
			end
			if parkWin.Visible and openedAt.park and (pos - openedAt.park).Magnitude > 20 then
				parkWin.Visible = false
			end
		end
	end
end)

---------------------------------------------------------------- ЧАСЫ, ПОГОДА, МУЗЫКА
local clockLbl = new("TextLabel", { Parent = gui, BackgroundColor3 = COLORS.bg, BackgroundTransparency = 0.2, Size = UDim2.new(0, 250, 0, 30), Position = UDim2.new(1, -262, 0, 10), Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = COLORS.text, Text = "" })
corner(clockLbl, 8)
local musicBtn = button(gui, "🎵 Музыка: вкл", COLORS.gray, 160, 28)
musicBtn.Position = UDim2.new(1, -172, 0, 46)
local WEATHER = { clear = "☀ Ясно", cloudy = "☁ Облачно", rain = "🌧 Дождь", snow = "❄ Снег" }

local music = Instance.new("Sound")
music.Name = "BackgroundMusic"
music.Volume = Config.MusicVolume or 0.25
music.Parent = SoundService
local musicOn = true
local tracks = Config.Music or {}
if #tracks == 0 then
	musicBtn.Visible = false
end
task.spawn(function()
	local i = 0
	while #tracks > 0 do
		if musicOn then
			i = i % #tracks + 1
			music.SoundId = tracks[i]
			music:Play()
			local t0 = os.clock()
			repeat
				task.wait(1)
			until not music.IsPlaying and os.clock() - t0 > 3
		else
			task.wait(1)
		end
	end
end)
musicBtn.MouseButton1Click:Connect(function()
	musicOn = not musicOn
	if musicOn then
		music:Resume()
	else
		music:Pause()
	end
	musicBtn.Text = musicOn and "🎵 Музыка: вкл" or "🔇 Музыка: выкл"
end)

-- дождь: частицы над камерой + звук
local rainPart = Instance.new("Part")
rainPart.Name = "RainEmitter"
rainPart.Anchored = true
rainPart.CanCollide = false
rainPart.CanQuery = false
rainPart.CanTouch = false
rainPart.Transparency = 1
rainPart.Size = Vector3.new(140, 1, 140)
rainPart.Parent = workspace
local rain = Instance.new("ParticleEmitter")
rain.Color = ColorSequence.new(Color3.fromRGB(190, 210, 235))
rain.LightEmission = 0.2
rain.Transparency = NumberSequence.new(0.35)
rain.Size = NumberSequence.new(0.12)
rain.Squash = NumberSequence.new(2.5)
rain.Lifetime = NumberRange.new(0.9, 1.2)
rain.Speed = NumberRange.new(70, 80)
rain.EmissionDirection = Enum.NormalId.Bottom
rain.SpreadAngle = Vector2.new(3, 3)
rain.Rate = 0
rain.Parent = rainPart
local rainSnd = Instance.new("Sound")
rainSnd.Looped = true
rainSnd.Volume = 0.35
rainSnd.SoundId = Config.RainSound or ""
rainSnd.Parent = SoundService

local isRaining = false
local isSnowing = false
-- снег: крупные медленные хлопья
local snow = Instance.new("ParticleEmitter")
snow.Color = ColorSequence.new(Color3.fromRGB(250, 250, 255))
snow.LightEmission = 0.3
snow.Transparency = NumberSequence.new(0.1)
snow.Size = NumberSequence.new(0.35)
snow.Lifetime = NumberRange.new(5, 7)
snow.Speed = NumberRange.new(8, 12)
snow.RotSpeed = NumberRange.new(-60, 60)
snow.SpreadAngle = Vector2.new(25, 25)
snow.EmissionDirection = Enum.NormalId.Bottom
snow.Rate = 0
snow.Parent = rainPart
local rainParams = RaycastParams.new()
rainParams.FilterType = Enum.RaycastFilterType.Exclude
RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if cam then
		local pos = cam.CFrame.Position
		rainPart.CFrame = CFrame.new(pos + Vector3.new(0, 45, 0))
		-- частицы не сталкиваются с деталями, поэтому под крышей дождь выключаем сами
		local ignore = { rainPart }
		if player.Character then
			table.insert(ignore, player.Character)
		end
		rainParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(pos, Vector3.new(0, 80, 0), rainParams)
		local underRoof = hit ~= nil and hit.Instance.Transparency < 0.9
		rain.Rate = (isRaining and not underRoof) and 900 or 0
		snow.Rate = (isSnowing and not underRoof) and 350 or 0
		rainSnd.Volume = underRoof and 0.12 or 0.35
	end
end)

task.spawn(function()
	while true do
		local clk = workspace:GetAttribute("Clock") or 8
		local h = math.floor(clk)
		local m = math.floor((clk - h) * 60)
		local w = workspace:GetAttribute("Weather") or "clear"
		local season = workspace:GetAttribute("Season") == "winter" and " · ❄ зима" or ""
		local night = workspace:GetAttribute("Night")
		clockLbl.Text = string.format("%s %02d:%02d · день %d · %s%s", night and "🌙" or "🕗", h, m, workspace:GetAttribute("Day") or 1, WEATHER[w] or w, season)
		local raining = (w == "rain")
		isSnowing = (w == "snow")
		isRaining = raining
		if raining and rainSnd.SoundId ~= "" and not rainSnd.IsPlaying then
			rainSnd:Play()
		elseif not raining and rainSnd.IsPlaying then
			rainSnd:Stop()
		end
		task.wait(0.5)
	end
end)

---------------------------------------------------------------- ОБНОВЛЕНИЕ
local pending = false
local function refreshAll()
	if pending then
		return
	end
	pending = true
	task.delay(0.15, function()
		pending = false
		renderComputer()
		renderInventory()
		renderJob()
		renderBank()
		renderProgress()
	end)
end
player.AttributeChanged:Connect(refreshAll)

task.spawn(function()
	local ls = player:WaitForChild("leaderstats")
	local c = ls:WaitForChild("Деньги")
	local function upd()
		cashLbl.Text = "💰 $" .. c.Value
	end
	upd()
	c.Changed:Connect(function()
		upd()
		refreshAll()
	end)
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000009"><Properties><string name="Name">Story</string><ProtectedString name="Source"><![CDATA[-- Story.client.lua — катсцены, диалоги, обучение, название мастерской
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Config = require(ReplicatedStorage:WaitForChild("MechanicConfig"))
local remotes = ReplicatedStorage:WaitForChild("MechanicRemotes")
local StoryEvent = remotes:WaitForChild("Story")

local gui = Instance.new("ScreenGui")
gui.Name = "StoryGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 20
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = o
end
local function stroke(o, col, th)
	local s = Instance.new("UIStroke")
	s.Color = col or Color3.fromRGB(255, 190, 70)
	s.Thickness = th or 2
	s.Parent = o
end
local function make(class, props)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	return o
end
local function tween(o, t, props, style)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), props)
	tw:Play()
	return tw
end

---------------------------------------------------------------- КИНО-ПОЛОСЫ И СУБТИТРЫ
local topBar = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), ZIndex = 50, Parent = gui })
local botBar = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 0), ZIndex = 50, Parent = gui })
local fade = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 60, Parent = gui })
local subtitle = make("TextLabel", {
	BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.new(0.8, 0, 0, 70), Font = Enum.Font.GothamMedium, TextSize = 24, TextWrapped = true,
	TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, Text = "", ZIndex = 55, Parent = gui,
})
local chapter = make("TextLabel", {
	BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22),
	Size = UDim2.new(0.8, 0, 0, 50), Font = Enum.Font.GothamBlack, TextSize = 34, TextColor3 = Color3.fromRGB(255, 200, 90),
	TextStrokeTransparency = 0.4, Text = "", TextTransparency = 1, ZIndex = 55, Parent = gui,
})
local skipBtn = make("TextButton", {
	AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -130), Size = UDim2.new(0, 170, 0, 40),
	BackgroundColor3 = Color3.fromRGB(30, 30, 35), BackgroundTransparency = 0.2, TextColor3 = Color3.new(1, 1, 1),
	Font = Enum.Font.GothamBold, TextSize = 18, Text = "Пропустить ⏭", Visible = false, ZIndex = 70, Parent = gui,
})
corner(skipBtn, 8)

local inCutscene = false
local skipRequested = false
skipBtn.MouseButton1Click:Connect(function()
	skipRequested = true
end)

local function letterbox(on)
	local h = on and 0.12 or 0
	tween(topBar, 0.6, { Size = UDim2.new(1, 0, h, 0) })
	tween(botBar, 0.6, { Size = UDim2.new(1, 0, h, 0) })
end

local function hideHud(hide)
	local hud = player.PlayerGui:FindFirstChild("MechanicUI")
	if hud and hud:IsA("ScreenGui") then
		hud.Enabled = not hide
	end
end

-- печатающийся текст; возвращает false, если нажали «Пропустить»
local function typeText(label, text, speed, stopFlag)
	label.Text = text
	label.MaxVisibleGraphemes = 0
	local total = utf8.len(text) or #text
	for i = 1, total do
		if stopFlag and stopFlag() then
			label.MaxVisibleGraphemes = -1
			return false
		end
		label.MaxVisibleGraphemes = i
		task.wait(speed or 0.03)
	end
	label.MaxVisibleGraphemes = -1
	return true
end

local function shot(fromCF, toCF, dur)
	camera.CFrame = fromCF
	local cv = Instance.new("CFrameValue")
	cv.Value = fromCF
	local conn = cv.Changed:Connect(function(v)
		camera.CFrame = v
	end)
	local tw = TweenService:Create(cv, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = toCF })
	tw:Play()
	return function()
		tw:Cancel()
		conn:Disconnect()
		cv:Destroy()
	end
end

local function look(pos, target)
	return CFrame.lookAt(pos, target)
end

local function beginCutscene()
	inCutscene = true
	skipRequested = false
	hideHud(true)
	camera.CameraType = Enum.CameraType.Scriptable
	letterbox(true)
	skipBtn.Visible = true
end

local function endCutscene()
	tween(fade, 0.4, { BackgroundTransparency = 0 }).Completed:Wait()
	camera.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		camera.CameraSubject = hum
	end
	subtitle.Text = ""
	chapter.TextTransparency = 1
	skipBtn.Visible = false
	letterbox(false)
	hideHud(false)
	tween(fade, 0.6, { BackgroundTransparency = 1 })
	inCutscene = false
end

local function playIntro(data)
	if inCutscene then
		return
	end
	local O = data.origin or Vector3.new()
	local lines = data.lines or Config.IntroLines
	local shots = {
		{ look(O + Vector3.new(55, 28, 94), O + Vector3.new(0, 6, 30)), look(O + Vector3.new(30, 16, 82), O + Vector3.new(0, 6, 40)) }, -- v4: камера между улицей и фасадом, не сквозь дома
		{ look(O + Vector3.new(-12, 6, 80), O + Vector3.new(0, 12, 52)), look(O + Vector3.new(10, 7, 68), O + Vector3.new(0, 11, 52)) },
		{ look(O + Vector3.new(28, 9, 49), O + Vector3.new(-36, 4, 36)), look(O + Vector3.new(18, 8, 44), O + Vector3.new(-30, 4, 34)) },
		{ look(O + Vector3.new(-20, 12, 36), O + Vector3.new(0, 3, -20)), look(O + Vector3.new(20, 10, 34), O + Vector3.new(0, 3, -25)) },
	}
	beginCutscene()
	fade.BackgroundTransparency = 0
	tween(fade, 1.2, { BackgroundTransparency = 1 })
	chapter.Text = "Глава 1. Старая мастерская"
	tween(chapter, 1, { TextTransparency = 0 })
	for i, line in ipairs(lines) do
		if skipRequested then
			break
		end
		local sh = shots[((i - 1) % #shots) + 1]
		local stop = shot(sh[1], sh[2], 7)
		typeText(subtitle, line, 0.035, function()
			return skipRequested
		end)
		local t0 = os.clock()
		while os.clock() - t0 < 2.6 and not skipRequested do
			task.wait(0.05)
		end
		stop()
		if i == 1 then
			tween(chapter, 1, { TextTransparency = 1 })
		end
	end
	endCutscene()
end

local function playNamed(data)
	local O = data.origin or Vector3.new()
	beginCutscene()
	skipBtn.Visible = false
	local stop = shot(look(O + Vector3.new(-25, 5, 92), O + Vector3.new(0, 12, 52)), look(O + Vector3.new(0, 9, 74), O + Vector3.new(0, 12, 52)), 6)
	chapter.Text = "«" .. tostring(data.name) .. "» — открыта!"
	tween(chapter, 0.8, { TextTransparency = 0 })
	-- конфетти
	local cols = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 210, 60), Color3.fromRGB(80, 200, 255), Color3.fromRGB(120, 255, 120), Color3.fromRGB(230, 120, 255) }
	for _ = 1, 70 do
		local c = make("Frame", {
			BackgroundColor3 = cols[math.random(1, #cols)], BorderSizePixel = 0, Rotation = math.random(0, 360),
			Size = UDim2.new(0, math.random(8, 14), 0, math.random(14, 22)),
			Position = UDim2.new(math.random(), 0, -0.05, 0), ZIndex = 56, Parent = gui,
		})
		local tw = tween(c, math.random(25, 45) / 10, { Position = UDim2.new(c.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0), Rotation = c.Rotation + math.random(180, 720) }, Enum.EasingStyle.Linear)
		tw.Completed:Connect(function()
			c:Destroy()
		end)
	end
	typeText(subtitle, "Новая вывеска загорелась. Клиенты уже едут!", 0.03)
	task.wait(3)
	stop()
	endCutscene()
end

---------------------------------------------------------------- ДИАЛОГ
local openNameUI -- объявлена ниже
local dlg = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(0, 640, 0, 150),
	BackgroundColor3 = Color3.fromRGB(28, 24, 20), BackgroundTransparency = 0.05, Visible = false, ZIndex = 40, Parent = gui,
})
corner(dlg, 14)
stroke(dlg)
local dlgFace = make("TextLabel", { BackgroundColor3 = Color3.fromRGB(70, 55, 40), Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(0, 84, 0, 84), Text = "👴", TextSize = 56, Font = Enum.Font.GothamBold, ZIndex = 41, Parent = dlg })
corner(dlgFace, 42)
local dlgName = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 112, 0, 10), Size = UDim2.new(1, -124, 0, 26), Font = Enum.Font.GothamBlack, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 200, 90), Text = "", ZIndex = 41, Parent = dlg })
local dlgText = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 112, 0, 38), Size = UDim2.new(1, -124, 0, 70), Font = Enum.Font.Gotham, TextSize = 19, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Color3.new(1, 1, 1), Text = "", ZIndex = 41, Parent = dlg })
local dlgNext = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -12), Size = UDim2.new(0, 130, 0, 34), BackgroundColor3 = Color3.fromRGB(255, 170, 50), Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Color3.fromRGB(30, 20, 10), Text = "Далее ▶", ZIndex = 41, Parent = dlg })
corner(dlgNext, 8)

local dlgQueue = nil
local dlgIdx = 0
local dlgTyping = false
local dlgSkipType = false

local function showLine()
	local line = dlgQueue.lines[dlgIdx]
	dlgNext.Text = (dlgIdx >= #dlgQueue.lines) and "Понял ✔" or "Далее ▶"
	dlgTyping = true
	dlgSkipType = false
	typeText(dlgText, line, 0.022, function()
		return dlgSkipType
	end)
	dlgTyping = false
end

local function openDialog(data)
	dlgQueue = data
	dlgIdx = 1
	dlgName.Text = data.speaker or ""
	dlg.Visible = true
	dlg.Position = UDim2.new(0.5, 0, 1, 180)
	tween(dlg, 0.35, { Position = UDim2.new(0.5, 0, 1, -24) }, Enum.EasingStyle.Back)
	task.spawn(showLine)
end

dlgNext.MouseButton1Click:Connect(function()
	if not dlgQueue then
		return
	end
	if dlgTyping then
		dlgSkipType = true
		return
	end
	if dlgIdx < #dlgQueue.lines then
		dlgIdx = dlgIdx + 1
		task.spawn(showLine)
	else
		local after = dlgQueue.after
		dlgQueue = nil
		dlg.Visible = false
		if after == "name" then
			openNameUI(true)
		end
	end
end)

---------------------------------------------------------------- НАЗВАНИЕ МАСТЕРСКОЙ
local nameFrame = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 460, 0, 250),
	BackgroundColor3 = Color3.fromRGB(26, 28, 34), Visible = false, ZIndex = 45, Parent = gui,
})
corner(nameFrame, 14)
stroke(nameFrame)
local nameTitle = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 34), Font = Enum.Font.GothamBlack, TextSize = 24, TextColor3 = Color3.fromRGB(255, 200, 90), Text = "🪧 Название мастерской", ZIndex = 46, Parent = nameFrame })
make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 50), Size = UDim2.new(1, -40, 0, 40), Font = Enum.Font.Gotham, TextSize = 15, TextWrapped = true, TextColor3 = Color3.fromRGB(200, 200, 210), Text = "Имя появится на вывеске, воротах, стойке, форме работников и в компьютере. До " .. Config.ShopNameMax .. " символов.", ZIndex = 46, Parent = nameFrame })
local nameBox = make("TextBox", { Position = UDim2.new(0, 20, 0, 100), Size = UDim2.new(1, -40, 0, 46), BackgroundColor3 = Color3.fromRGB(45, 48, 58), TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "Например: АвтоДок у Руслана", PlaceholderColor3 = Color3.fromRGB(130, 130, 140), Font = Enum.Font.GothamBold, TextSize = 20, ClearTextOnFocus = false, Text = "", ZIndex = 46, Parent = nameFrame })
corner(nameBox, 8)
local nameCount = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 148), Size = UDim2.new(1, -40, 0, 20), Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(160, 160, 170), Text = "0/" .. Config.ShopNameMax, ZIndex = 46, Parent = nameFrame })
local nameOk = make("TextButton", { Position = UDim2.new(0, 20, 1, -64), Size = UDim2.new(0.5, -26, 0, 46), BackgroundColor3 = Color3.fromRGB(70, 190, 90), Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "✔ Готово", ZIndex = 46, Parent = nameFrame })
corner(nameOk, 8)
local nameCancel = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 1, -64), Size = UDim2.new(0.5, -26, 0, 46), BackgroundColor3 = Color3.fromRGB(90, 90, 100), Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "Отмена", ZIndex = 46, Parent = nameFrame })
corner(nameCancel, 8)

nameBox:GetPropertyChangedSignal("Text"):Connect(function()
	local t = nameBox.Text
	if (utf8.len(t) or #t) > Config.ShopNameMax then
		local cut = utf8.offset(t, Config.ShopNameMax + 1)
		if cut then
			nameBox.Text = string.sub(t, 1, cut - 1)
			return
		end
	end
	nameCount.Text = (utf8.len(t) or #t) .. "/" .. Config.ShopNameMax
end)

local nameRequired = false
openNameUI = function(required)
	nameRequired = required and true or false
	nameCancel.Visible = not nameRequired
	nameOk.Size = nameRequired and UDim2.new(1, -40, 0, 46) or UDim2.new(0.5, -26, 0, 46)
	nameTitle.Text = nameRequired and "🪧 Придумайте название!" or "✏ Переименовать мастерскую"
	nameBox.Text = player:GetAttribute("ShopName") or ""
	nameFrame.Visible = true
	nameFrame.Size = UDim2.new(0, 400, 0, 210)
	tween(nameFrame, 0.25, { Size = UDim2.new(0, 460, 0, 250) }, Enum.EasingStyle.Back)
	nameBox:CaptureFocus()
end

nameOk.MouseButton1Click:Connect(function()
	local t = nameBox.Text
	if string.match(t, "%S") == nil then
		nameBox.PlaceholderText = "Введите хотя бы один символ"
		return
	end
	StoryEvent:FireServer("setName", t)
	nameFrame.Visible = false
end)
nameCancel.MouseButton1Click:Connect(function()
	nameFrame.Visible = false
end)

-- кнопка переименования (после обучения)
local renameBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 150, 0, 36), BackgroundColor3 = Color3.fromRGB(40, 42, 50), BackgroundTransparency = 0.15, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.fromRGB(255, 200, 90), Text = "✏ Название", Visible = false, ZIndex = 30, Parent = gui })
corner(renameBtn, 8)
renameBtn.MouseButton1Click:Connect(function()
	openNameUI(false)
end)

---------------------------------------------------------------- ЗАДАНИЕ ОБУЧЕНИЯ + УКАЗАТЕЛЬ
local objFrame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 58), Size = UDim2.new(0, 520, 0, 74), BackgroundColor3 = Color3.fromRGB(24, 26, 32), BackgroundTransparency = 0.1, Visible = false, ZIndex = 30, Parent = gui })
corner(objFrame, 12)
stroke(objFrame, Color3.fromRGB(90, 170, 255), 2)
local objHead = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -28, 0, 20), Font = Enum.Font.GothamBlack, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(120, 190, 255), Text = "", ZIndex = 31, Parent = objFrame })
local objText = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 26), Size = UDim2.new(1, -28, 0, 44), Font = Enum.Font.GothamMedium, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Color3.new(1, 1, 1), Text = "", ZIndex = 31, Parent = objFrame })
local objBar = make("Frame", { BackgroundColor3 = Color3.fromRGB(90, 170, 255), BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(0, 0, 0, 4), ZIndex = 31, Parent = objFrame })

-- маркер цели в мире
local marker = Instance.new("Part")
marker.Name = "TutorialMarker"
marker.Anchored = true
marker.CanCollide = false
marker.CanQuery = false
marker.CanTouch = false
marker.Transparency = 1
marker.Size = Vector3.new(0.5, 0.5, 0.5)
local markerAtt = Instance.new("Attachment")
markerAtt.Parent = marker
local bb = Instance.new("BillboardGui")
bb.Size = UDim2.new(0, 70, 0, 70)
bb.AlwaysOnTop = true
bb.Parent = marker
local arrow = make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "⬇", TextSize = 56, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(90, 190, 255), TextStrokeTransparency = 0.3, Parent = bb })
local beam = Instance.new("Beam")
beam.Attachment1 = markerAtt
beam.Width0 = 0.6
beam.Width1 = 0.6
beam.FaceCamera = true
beam.LightEmission = 1
beam.Color = ColorSequence.new(Color3.fromRGB(90, 190, 255))
beam.Transparency = NumberSequence.new(0.35)
beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
beam.TextureMode = Enum.TextureMode.Static
beam.TextureLength = 2
beam.TextureSpeed = 1.5
beam.Parent = marker
local charAtt = nil

local function attachBeam()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		charAtt = root:FindFirstChild("TutorialAtt") or Instance.new("Attachment")
		charAtt.Name = "TutorialAtt"
		charAtt.Parent = root
		beam.Attachment0 = charAtt
	end
end
player.CharacterAdded:Connect(function(char)
	char:WaitForChild("HumanoidRootPart")
	attachBeam()
end)
attachBeam()

local function refreshObjective()
	local text = player:GetAttribute("TutStep")
	local num = player:GetAttribute("TutStepNum")
	local target = player:GetAttribute("TutTarget")
	if text and text ~= "" then
		local total = #Config.Tutorial
		objHead.Text = "📘 ОБУЧЕНИЕ · шаг " .. tostring(num or "?") .. "/" .. total
		objText.Text = text
		if not objFrame.Visible then
			objFrame.Visible = true
		end
		tween(objBar, 0.5, { Size = UDim2.new(((num or 1) - 1) / total, 0, 0, 4) })
	else
		objFrame.Visible = false
	end
	if typeof(target) == "Vector3" then
		marker.Position = target
		marker.Parent = workspace
	else
		marker.Parent = nil
	end
	renameBtn.Visible = player:GetAttribute("ShopName") ~= nil and not (text and text ~= "")
end
for _, a in ipairs({ "TutStep", "TutStepNum", "TutTarget", "ShopName" }) do
	player:GetAttributeChangedSignal(a):Connect(refreshObjective)
end
refreshObjective()

local t = 0
RunService.RenderStepped:Connect(function(dt)
	if marker.Parent then
		t = t + dt
		bb.StudsOffset = Vector3.new(0, 1 + math.sin(t * 4) * 0.6, 0)
		arrow.TextTransparency = 0.1 + (math.sin(t * 6) + 1) * 0.1
	end
end)

---------------------------------------------------------------- СОБЫТИЯ СЕРВЕРА
StoryEvent.OnClientEvent:Connect(function(kind, data)
	data = data or {}
	if kind == "intro" then
		task.spawn(playIntro, data)
	elseif kind == "dialog" then
		openDialog(data)
	elseif kind == "name" then
		openNameUI(true)
	elseif kind == "named" then
		task.spawn(playNamed, data)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>