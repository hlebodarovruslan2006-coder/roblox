---------------------------------------------------------------- API
function M.has(id)
	return B[id] ~= nil
end

-- Возвращает Model, собранную вокруг (0,0,0), низ модели на y=0
function M.build(id)
	local m = Instance.new("Model")
	m.Name = "Model_" .. tostring(id)
	local f = B[id]
	if f then
		f(m)
	else
		add(m, "B", V(1, 1, 1), V(0, 0.5, 0), C.steel)
	end
	return m
end

-- Готовая модель в заданной позиции/повороте и (по желанию) в масштабе
function M.place(id, cf, scale, parent)
	local m = M.build(id)
	if scale and scale ~= 1 then
		pcall(function()
			m:ScaleTo(scale)
		end)
	end
	local origin = CFrame.new()
	local pivotOffset = m.PrimaryPart.CFrame:ToObjectSpace(origin)
	m.PrimaryPart.PivotOffset = pivotOffset
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

-- Превью в ViewportFrame (для интерфейса)
function M.viewport(id, parent, size, rotate)
	local vf = Instance.new("ViewportFrame")
	vf.Size = size or UDim2.new(0, 64, 0, 64)
	vf.BackgroundColor3 = Color3.fromRGB(32, 34, 42)
	vf.BorderSizePixel = 0
	vf.Ambient = Color3.fromRGB(170, 170, 180)
	vf.LightColor = Color3.fromRGB(255, 250, 240)
	vf.LightDirection = Vector3.new(-1, -1.5, -1)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = vf
	local m = M.build(id)
	m.Parent = vf
	local cf, sz = m:GetBoundingBox()
	local r = math.max(sz.X, sz.Y, sz.Z)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vf
	vf.CurrentCamera = cam
	local center = cf.Position
	local dist = r * 1.6 + 1
	local function aim(a)
		local off = Vector3.new(math.sin(a) * dist, r * 0.55, math.cos(a) * dist)
		cam.CFrame = CFrame.lookAt(center + off, center)
	end
	aim(math.rad(35))
	vf.Parent = parent
	if rotate then
		local a = 0
		task.spawn(function()
			while vf.Parent do
				a = a + 0.03
				aim(a)
				task.wait(0.03)
			end
		end)
	end
	return vf
end

return M
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX00000007"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBXMOD00001"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBXMOD00002"><Properties><string name="Name">DataSave</string><ProtectedString name="Source"><![CDATA[-- DataSave (ModuleScript, ServerScriptService → Modules)
-- Надёжные сохранения: повторные попытки, UpdateAsync, очередь, ожидание при выключении сервера.

local DataStoreService = game:GetService("DataStoreService")

local M = {}

local RETRIES = 4
local store = nil
local saving = {} -- key -> true, пока идёт запись
local queued = {} -- key -> самые свежие данные, пришедшие во время записи

function M.init(name)
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok then
		store = res
	else
		warn("[DataSave] DataStore недоступен: " .. tostring(res))
	end
	return store ~= nil
end

function M.available()
	return store ~= nil
end

-- ждём, пока у Roblox есть лимит запросов (иначе запрос просто встанет в очередь/упадёт)
local function waitBudget(kind)
	for _ = 1, 20 do
		local ok, b = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(kind)
		end)
		if not ok or b > 0 then
			return
		end
		task.wait(0.5)
	end
end

-- ошибки, при которых повторять бессмысленно (например, в Studio выключен доступ к API)
local function fatal(err)
	local s = tostring(err)
	return string.find(s, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(s, "API access", 1, true) ~= nil
		or string.find(s, "403", 1, true) ~= nil
end

-- возвращает ok, data. ok = false — загрузить не удалось, сохранять такую сессию НЕЛЬЗЯ.
function M.load(key)
	if not store then
		return true, nil
	end
	for i = 1, RETRIES do
		waitBudget(Enum.DataStoreRequestType.GetAsync)
		local ok, res = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			return true, res
		end
		warn(("[DataSave] Загрузка %s, попытка %d: %s"):format(key, i, tostring(res)))
		if fatal(res) then
			break
		end
		if i < RETRIES then
			task.wait(i * 1.5)
		end
	end
	return false, nil
end

-- запись с повторами. Если запись уже идёт — новые данные запишутся сразу после неё.
function M.save(key, data)
	if not store then
		return false
	end
	if saving[key] then
		queued[key] = data
		return true
	end
	saving[key] = true
	local success = false
	local current = data
	while current do
		queued[key] = nil
		local payload = current
		success = false
		for i = 1, RETRIES do
			waitBudget(Enum.DataStoreRequestType.UpdateAsync)
			local ok, err = pcall(function()
				store:UpdateAsync(key, function()
					return payload
				end)
			end)
			if ok then
				success = true
				break
			end
			warn(("[DataSave] Сохранение %s, попытка %d: %s"):format(key, i, tostring(err)))
			if fatal(err) then
				break
			end
			if i < RETRIES then
				task.wait(i * 1.5)
			end
		end
		current = queued[key]
	end
	saving[key] = nil
	return success
end

-- ждём окончания всех записей (для BindToClose)
function M.waitAll(timeout)
	local t0 = os.clock()
	while next(saving) and os.clock() - t0 < (timeout or 25) do
		task.wait(0.1)
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMOD00003"><Properties><string name="Name">NpcRig</string><ProtectedString name="Source"><![CDATA[-- NpcRig (ModuleScript, ServerScriptService → Modules)
-- R15-персонажи для NPC (персонал, клиенты, Михалыч) со стандартными анимациями Roblox.
-- Пивот модели совпадает со старым блочным: точка на высоте 3 над полом, лицом по -Z.
-- Если R15 создать не удалось, GameServer сам откатывается на старых блочных персонажей.

local Players = game:GetService("Players")

local M = {}

-- стандартные R15-анимации Roblox (доступны в любой игре)
M.Anims = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	sit = "rbxassetid://2506281703",
}

local STAND_PIVOT_Y = 3

local base = nil
local loading = false
local failed = false

local function getBase()
	if base or failed then
		return base
	end
	if loading then
		while loading do
			task.wait(0.05)
		end
		return base
	end
	loading = true
	local ok, res = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and res then
		for _, c in ipairs(res:GetDescendants()) do
			if c:IsA("LuaSourceContainer") or c:IsA("BodyColors") or c:IsA("Clothing") or c:IsA("ShirtGraphic") or c:IsA("Accessory") then
				c:Destroy()
			end
		end
		if res:FindFirstChildOfClass("Humanoid") and res:FindFirstChild("HumanoidRootPart") then
			base = res
		end
	else
		warn("[NpcRig] Не удалось создать R15, будут блочные NPC: " .. tostring(res))
	end
	failed = (base == nil)
	loading = false
	return base
end

function M.preload()
	task.spawn(getBase)
end

local TORSO = { "UpperTorso", "LowerTorso" }
local ARMS = { "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm" }
local HANDS = { "LeftHand", "RightHand" }
local LEGS = { "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" }
local FEET = { "LeftFoot", "RightFoot" }

local function paint(m, names, color, mat)
	if not color then
		return
	end
	for _, n in ipairs(names) do
		local p = m:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			p.Color = color
			if mat then
				p.Material = mat
			end
		end
	end
end

-- маленькая деталь (кепка, галстук и т.п.), приваренная к части тела
local function deco(m, attach, name, size, offset, color, mat)
	if not attach or not color then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = attach.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = attach
	w.Part1 = p
	w.Parent = p
	p.Parent = m
	return p
end

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- o: таблица одежды из Outfits / randomClientOutfit; skin: цвет кожи
-- возвращает model, torso (UpperTorso) или nil, если R15 недоступен
function M.build(o, name, parent, skin)
	local b = getBase()
	if not b then
		return nil
	end
	local m = b:Clone()
	m.Name = name or "NPC"
	local hum = m:FindFirstChildOfClass("Humanoid")
	local hrp = m:FindFirstChild("HumanoidRootPart")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	if not hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = hum
	end

	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
			p.Anchored = false
		end
	end

	-- одежда цветом частей тела
	local top = (o.suit and rgb(25, 25, 30)) or o.shirt
	paint(m, { "Head" }, skin)
	paint(m, HANDS, skin)
	paint(m, TORSO, top, Enum.Material.SmoothPlastic)
	paint(m, { "UpperTorso" }, o.vest, Enum.Material.Fabric)
	paint(m, ARMS, (o.suit and rgb(25, 25, 30)) or o.jacket or o.shirt)
	paint(m, { "LowerTorso" }, o.pants)
	paint(m, LEGS, o.pants)
	paint(m, FEET, o.shoes)

	local head = m:FindFirstChild("Head")
	if head and not head:FindFirstChildOfClass("Decal") then
		local face = Instance.new("Decal")
		face.Name = "face"
		face.Texture = "rbxasset://textures/face.png"
		face.Face = Enum.NormalId.Front
		face.Parent = head
	end
	local ut = m:FindFirstChild("UpperTorso")
	local lt = m:FindFirstChild("LowerTorso")

	if head then
		local hs = head.Size
		if o.hat == "cap" then
			local c = o.hatColor or rgb(200, 80, 20)
			deco(m, head, "Cap", Vector3.new(hs.X + 0.12, 0.4, hs.Z + 0.12), CFrame.new(0, hs.Y / 2 + 0.1, 0), c)
			deco(m, head, "Visor", Vector3.new(hs.X, 0.1, 0.6), CFrame.new(0, hs.Y / 2 - 0.05, -hs.Z / 2 - 0.25), c)
		elseif o.hair then
			deco(m, head, "Hair", Vector3.new(hs.X + 0.08, 0.3, hs.Z + 0.08), CFrame.new(0, hs.Y / 2 + 0.05, 0.03), o.hair)
			deco(m, head, "HairBack", Vector3.new(hs.X + 0.08, hs.Y * 0.6, 0.22), CFrame.new(0, hs.Y * 0.15, hs.Z / 2 + 0.05), o.hair)
		end
		if o.beard then
			deco(m, head, "Beard", Vector3.new(hs.X * 0.85, hs.Y * 0.4, 0.22), CFrame.new(0, -hs.Y * 0.3, -hs.Z / 2 - 0.05), o.beard)
		end
	end
	if ut then
		local us = ut.Size
		if o.suit then
			deco(m, ut, "Shirt", Vector3.new(0.6, us.Y * 0.95, 0.05), CFrame.new(0, 0, -us.Z / 2 - 0.02), rgb(245, 245, 245))
			deco(m, ut, "Tie", Vector3.new(0.22, us.Y * 0.75, 0.06), CFrame.new(0, 0.05, -us.Z / 2 - 0.06), o.tie)
		end
		if o.stripes then
			deco(m, ut, "Pocket", Vector3.new(0.5, 0.45, 0.05), CFrame.new(0.45, 0.2, -us.Z / 2 - 0.02), rgb(15, 35, 90))
		end
	end
	if lt then
		local ls = lt.Size
		if o.stripes then
			deco(m, lt, "Stripe", Vector3.new(ls.X + 0.04, 0.2, ls.Z + 0.04), CFrame.new(0, 0, 0), o.stripes, Enum.Material.Neon)
			for _, n in ipairs({ "LeftLowerLeg", "RightLowerLeg" }) do
				local leg = m:FindFirstChild(n)
				if leg then
					deco(m, leg, "LegStripe", Vector3.new(leg.Size.X + 0.04, 0.2, leg.Size.Z + 0.04), CFrame.new(0, 0, 0), o.stripes, Enum.Material.Neon)
				end
			end
		end
		if o.belt then
			deco(m, lt, "ToolBelt", Vector3.new(ls.X + 0.1, 0.35, ls.Z + 0.1), CFrame.new(0, 0.1, 0), o.belt)
			deco(m, lt, "Pouch", Vector3.new(0.5, 0.6, 0.4), CFrame.new(0.7, -0.2, -ls.Z / 2 - 0.15), o.belt)
		end
	end

	-- пивот как у старого блочного персонажа: y = 3 над полом
	local rootH = hum.HipHeight + hrp.Size.Y / 2
	hrp.PivotOffset = CFrame.new(0, STAND_PIVOT_Y - rootH, 0)
	m.PrimaryPart = hrp
	hrp.Anchored = true
	m:PivotTo(CFrame.new(0, STAND_PIVOT_Y, 0))
	m.Parent = parent
	M.play(m, "idle")
	return m, ut or hrp
end

-- Аватар реального игрока по UserId (Config.NpcAvatars)
local avatarCache = {}
local avatarLoading = {}
local avatarFailAt = {}

local function getAvatarBase(userId)
	if avatarCache[userId] then
		return avatarCache[userId]
	end
	if avatarFailAt[userId] and os.clock() - avatarFailAt[userId] < 60 then
		return nil
	end
	if avatarLoading[userId] then
		while avatarLoading[userId] do
			task.wait(0.05)
		end
		return avatarCache[userId]
	end
	avatarLoading[userId] = true
	local ok, res = pcall(function()
		local desc = Players:GetHumanoidDescriptionFromUserId(userId)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and res and res:FindFirstChildOfClass("Humanoid") and res:FindFirstChild("HumanoidRootPart") then
		for _, c in ipairs(res:GetDescendants()) do
			if c:IsA("LuaSourceContainer") then
				c:Destroy()
			end
		end
		avatarCache[userId] = res
	else
		avatarFailAt[userId] = os.clock()
		warn("[NpcRig] Не удалось загрузить аватар " .. tostring(userId) .. ": " .. tostring(res))
	end
	avatarLoading[userId] = nil
	return avatarCache[userId]
end

function M.preloadAvatar(userId)
	userId = tonumber(userId)
	if userId and userId > 0 then
		task.spawn(getAvatarBase, userId)
	end
end

-- возвращает model, torso или nil (тогда GameServer берёт обычную униформу)
function M.buildAvatar(userId, name, parent)
	userId = tonumber(userId)
	if not userId or userId <= 0 then
		return nil
	end
	local b = getAvatarBase(userId)
	if not b then
		return nil
	end
	local m = b:Clone()
	m.Name = name or "NPC"
	local hum = m:FindFirstChildOfClass("Humanoid")
	local hrp = m:FindFirstChild("HumanoidRootPart")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	if not hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = hum
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
			p.Anchored = false
		end
	end
	local rootH = hum.HipHeight + hrp.Size.Y / 2
	hrp.PivotOffset = CFrame.new(0, STAND_PIVOT_Y - rootH, 0)
	m.PrimaryPart = hrp
	hrp.Anchored = true
	m:PivotTo(CFrame.new(0, STAND_PIVOT_Y, 0))
	m.Parent = parent
	M.play(m, "idle")
	return m, m:FindFirstChild("UpperTorso") or hrp
end

local tracks = setmetatable({}, { __mode = "k" })

-- kind: "idle" | "walk" | "sit". Для блочных персонажей ничего не делает.
function M.play(m, kind, speed)
	local hum = m and m:FindFirstChildOfClass("Humanoid")
	if not hum or not m.Parent then
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local t = tracks[m]
	if not t then
		t = {}
		tracks[m] = t
	end
	local tr = t[kind]
	if not tr then
		local a = Instance.new("Animation")
		a.AnimationId = M.Anims[kind]
		local ok, res = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if not ok or not res then
			return
		end
		tr = res
		tr.Looped = true
		tr.Priority = (kind == "walk") and Enum.AnimationPriority.Movement
			or (kind == "sit") and Enum.AnimationPriority.Action
			or Enum.AnimationPriority.Idle
		t[kind] = tr
	end
	for k, other in pairs(t) do
		if k ~= kind and other.IsPlaying then
			other:Stop(0.2)
		end
	end
	if not tr.IsPlaying then
		tr:Play(0.2)
	end
	if speed then
		tr:AdjustSpeed(math.clamp(speed, 0.4, 1.6))
	end
end

-- Посадить R15 на невидимое сиденье. seatTopCF — верх подушки кресла, LookVector = куда смотрит человек.
-- Возвращает false, если модель не R15 (тогда GameServer использует блочного сидящего).
function M.sit(m, seatTopCF)
	local hum = m and m:FindFirstChildOfClass("Humanoid")
	local hrp = m and m:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then
		return false
	end
	m:PivotTo(seatTopCF * CFrame.new(0, STAND_PIVOT_Y, 0))
	local seat = Instance.new("Seat")
	seat.Name = "NpcSeat"
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanTouch = false -- игроки не сядут на него случайно
	seat.CanQuery = false
	seat.Anchored = true
	seat.CFrame = seatTopCF * CFrame.new(0, -0.1, 0)
	seat.Parent = m.Parent
	m.Destroying:Connect(function()
		seat:Destroy()
	end)
	hrp.Anchored = false
	local ok = pcall(function()
		seat:Sit(hum)
	end)
	if not ok or not seat:FindFirstChild("SeatWeld") then
		-- запасной вариант: просто ставим в позу сидя
		hrp.Anchored = true
		hrp.CFrame = seatTopCF * CFrame.new(0, hrp.Size.Y / 2 + 0.6, 0)
	end
	M.play(m, "sit")
	return true
end

return M
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX00000006"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer (Script, ServerScriptService)
-- v4: парковка и выбор машины, смотровая яма, день/ночь и погода, банк и кредиты,
-- подарки, звуки, новые детали, несколько ремонтов одновременно, новый город.
-- v3.1: свои модели машин из Toolbox (ServerStorage → CarModels).
-- Симулятор автомеханика v3: сюжет и обучение, боксы на 4 игроков, своё название мастерской.
-- v2: Check Engine и сканер, болты (ржавые / WD-40 / молоток),
-- капиталка на стенде, шиномонтаж, компьютер с заказом деталей, работники, донат.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("MechanicConfig"))

local CASH = "Деньги"
local REPAIRS = "Ремонты"

-- модули (ServerScriptService → Modules)
local Modules = script.Parent:WaitForChild("Modules")
local DataSave = require(Modules:WaitForChild("DataSave"))
local NpcRig = require(Modules:WaitForChild("NpcRig"))
-- тот же ключ, что и раньше: старый прогресс игроков сохраняется
DataSave.init("AutoMechanicSim_v2")
NpcRig.preload()
for _, uid in pairs(Config.NpcAvatars or {}) do
	NpcRig.preloadAvatar(uid)
end

---------------------------------------------------------------- УДАЛЁННЫЕ СОБЫТИЯ
local remotes = Instance.new("Folder")
remotes.Name = "MechanicRemotes"
local function remote(cls, name)
	local r = Instance.new(cls)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyEvent = remote("RemoteEvent", "Notify")
local OpenUIEvent = remote("RemoteEvent", "OpenUI")
local JobUpdateEvent = remote("RemoteEvent", "JobUpdate")
local JobActionEvent = remote("RemoteEvent", "JobAction")
local ShopFunction = remote("RemoteFunction", "ShopAction")
local StoryEvent = remote("RemoteEvent", "Story")
local ParkingEvent = remote("RemoteEvent", "Parking")
remotes.Parent = ReplicatedStorage

local PD = {}          -- player -> служебные данные
local viewing = {}     -- player -> номер поста, который открыт в панели
local activeFault = {} -- player -> текущий ремонт
local NPCs = {}        -- player -> { workerId -> { model, label } }
local Bays = {}

local function notify(p, text, kind)
	NotifyEvent:FireClient(p, text, kind or "info")
end

---------------------------------------------------------------- ПРОГРЕСС: РАНГ, ЗВЁЗДЫ, ЗАДАНИЯ, ЕЖЕДНЕВНАЯ НАГРАДА, БУСТ
local HttpService = game:GetService("HttpService")
local STARS = "Рейтинг"
local Hooks = {} -- refreshSigns(p) задаётся ниже, когда появятся участки

local function today()
	return math.floor(os.time() / 86400)
end

local function repairsOf(p)
	local ls = p:FindFirstChild("leaderstats")
	local r = ls and ls:FindFirstChild(REPAIRS)
	return r and r.Value or 0
end

local function rankOf(repairs)
	local idx = 1
	for i, r in ipairs(Config.Ranks) do
		if repairs >= r.repairs then
			idx = i
		end
	end
	return idx, Config.Ranks[idx]
end

local function ratingOf(d)
	local list = d and d.reviews
	if not list or #list == 0 then
		return nil
	end
	local s = 0
	for _, v in ipairs(list) do
		s = s + v
	end
	return s / #list
end

local function boostActive(p)
	return (p:GetAttribute("BoostUntil") or 0) > os.time()
end

local function syncProgress(p)
	local d = PD[p]
	if not d then
		return
	end
	local idx, rk = rankOf(repairsOf(p))
	if d.rank and idx > d.rank then
		notify(p, "🏅 Новый ранг мастерской: «" .. rk.name .. "»! Бонус к доходу: +" .. math.floor(rk.bonus * 100 + 0.5) .. "%", "good")
	end
	d.rank = idx
	p:SetAttribute("Rank", idx)
	local rating = ratingOf(d)
	p:SetAttribute("Rating", rating and math.floor(rating * 10 + 0.5) / 10 or 0)
	p:SetAttribute("RatingCount", d.reviewsTotal or 0)
	local ls = p:FindFirstChild("leaderstats")
	local st = ls and ls:FindFirstChild(STARS)
	if st then
		st.Value = rating and string.format("★%.1f", rating) or "—"
	end
	if Hooks.refreshSigns then
		Hooks.refreshSigns(p)
	end
end

local function questsSync(p)
	local d = PD[p]
	if d and d.quests then
		p:SetAttribute("Quests", HttpService:JSONEncode(d.quests.list))
	end
end

-- новые сутки: новые задания и проверка ежедневной награды
local function ensureDaily(p)
	local d = PD[p]
	if not d then
		return
	end
	local t = today()
	if not d.quests or d.quests.day ~= t then
		local pool = table.clone(Config.DailyQuests)
		local list, used = {}, {}
		while #list < (Config.QuestsPerDay or 3) and #pool > 0 do
			local q = table.remove(pool, math.random(1, #pool))
			local key = q.kind .. (q.fault or "")
			if not used[key] then
				used[key] = true
				table.insert(list, { id = q.id, n = 0, claimed = false })
			end
		end
		local fresh = d.quests ~= nil
		d.quests = { day = t, list = list }
		questsSync(p)
		if fresh and d.tut then
			notify(p, "📋 Новые задания на день! Кнопка «📋 Мастерская»", "info")
		end
	end
	d.daily = d.daily or { day = -1, streak = 0 }
	local ready = d.daily.day ~= t
	local streak = d.daily.streak or 0
	if ready then
		streak = (d.daily.day == t - 1) and (streak % #Config.DailyRewards) + 1 or 1
	end
	if ready and not p:GetAttribute("DailyReady") and d.tut then
		notify(p, "🎁 Ежедневная награда ждёт! Кнопка «📋 Мастерская»", "good")
	end
	p:SetAttribute("DailyReady", ready)
	p:SetAttribute("DailyStreak", streak)
end

local function questAdd(p, kind, amount, faultId)
	local d = PD[p]
	if not d or not d.quests or not d.tut then
		return
	end
	local changed = false
	for _, q in ipairs(d.quests.list) do
		local def = Config.QuestById[q.id]
		if def and def.kind == kind and (not def.fault or def.fault == faultId) and q.n < def.goal then
			q.n = math.min(def.goal, q.n + amount)
			changed = true
			if q.n >= def.goal then
				notify(p, "📋 Задание выполнено: «" .. def.text .. "». Заберите награду в «📋 Мастерская»", "good")
			end
		end
	end
	if changed then
		questsSync(p)
	end
end

local function addReview(p, stars, why)
	local d = PD[p]
	if not d then
		return
	end
	d.reviews = d.reviews or {}
	table.insert(d.reviews, stars)
	while #d.reviews > (Config.RatingWindow or 20) do
		table.remove(d.reviews, 1)
	end
	d.reviewsTotal = (d.reviewsTotal or 0) + 1
	local txt = "Отзыв клиента: " .. string.rep("★", stars) .. string.rep("☆", 5 - stars)
	if why ~= "" then
		txt = txt .. " (" .. why .. ")"
	end
	notify(p, txt, stars >= 4 and "good" or "bad")
	if stars == 5 then
		questAdd(p, "stars5", 1)
	end
	syncProgress(p)
end

---------------------------------------------------------------- ДЕНЬГИ И СКЛАД
local function cashObj(p)
	local ls = p:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild(CASH)
end

local function getCash(p)
	local c = cashObj(p)
	return c and c.Value or 0
end

-- множитель доходов: x2 денег, буст, VIP, ранг мастерской
local function incomeMult(p)
	local m = 1
	if p:GetAttribute("Pass_x2cash") then
		m = m * 2
	end
	if boostActive(p) then
		m = m * 2
	end
	if p:GetAttribute("Pass_vip") then
		m = m * (1 + (Config.VipIncomeBonus or 0.25))
	end
	local _, rk = rankOf(repairsOf(p))
	return m * (1 + (rk.bonus or 0))
end

local function addCash(p, amount, isIncome)
	local c = cashObj(p)
	if not c then
		return 0
	end
	if isIncome then
		amount = amount * incomeMult(p)
	end
	amount = math.floor(amount + 0.5)
	c.Value = c.Value + amount
	if isIncome and amount > 0 then
		questAdd(p, "earn", amount)
	end
	return amount
end

local function spend(p, amount)
	local c = cashObj(p)
	if not c or c.Value < amount then
		return false
	end
	c.Value = c.Value - amount
	return true
end

local function addRepair(p)
	local ls = p:FindFirstChild("leaderstats")
	local r = ls and ls:FindFirstChild(REPAIRS)
	if r then
		r.Value = r.Value + 1
	end
end

local function invGet(p, id)
	return p:GetAttribute("Inv_" .. id) or 0
end

local function invAdd(p, id, n)
	p:SetAttribute("Inv_" .. id, math.max(0, invGet(p, id) + n))
end

local function owns(p, id)
	return p:GetAttribute("Own_" .. id) == true
end

local function hired(p, id)
	return p:GetAttribute("Hire_" .. id) == true
end

local function itemName(id)
	local it = Config.ItemById[id]
	return it and it.name or id
end

---------------------------------------------------------------- ПОСТРОЕНИЕ МИРА
local world = Instance.new("Folder")
world.Name = "Garage"
world.Parent = workspace

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or world
	return p
end

local function label3d(adornee, text, offsetY, color, w, h)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, w or 240, 0, h or 56)
	bb.StudsOffset = Vector3.new(0, offsetY or 3, 0)
	bb.MaxDistance = 80
	bb.Adornee = adornee
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.Text = text
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.TextColor3 = color or Color3.new(1, 1, 1)
	tl.TextStrokeTransparency = 0.3
	tl.Parent = bb
	bb.Parent = adornee
	return tl
end

local function prompt(parentPart, action, object, cb)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.Parent = parentPart
	pp.Triggered:Connect(cb)
	return pp
end

local openJob
local openActive

-- звуковой эффект в точке мира (ключи — Config.Sounds)
local Debris = game:GetService("Debris")
local function sfx(pos, key)
	local s = Config.Sounds and Config.Sounds[key]
	if not s or not s.id or s.id == "" or not pos then
		return
	end
	pcall(function()
		local a = Instance.new("Part")
		a.Name = "Sfx"
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.Transparency = 1
		a.Size = Vector3.new(0.5, 0.5, 0.5)
		a.Position = pos + Vector3.new(0, 3, 0)
		a.Parent = workspace
		local snd = Instance.new("Sound")
		snd.SoundId = s.id
		snd.Volume = s.volume or 0.7
		snd.PlaybackSpeed = s.pitch or 1
		snd.RollOffMaxDistance = 90
		snd.RollOffMinDistance = 8
		snd.Parent = a
		local loops = s.loops or 1
		task.spawn(function()
			for _ = 1, loops do
				if not a.Parent then
					return
				end
				snd:Play()
				local len = snd.TimeLength
				task.wait((len > 0 and len / snd.PlaybackSpeed or 0.3) * 0.9)
			end
		end)
		Debris:AddItem(a, 2 + loops * 1.2)
	end)
end

